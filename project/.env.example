# Copie para .env e preencha. O .env nunca deve ser versionado nem compartilhado.
# Usado só por `ddsd generate run <provedor>` (mitigação do corpus).
#
# Os modelos abaixo estão comentados com o padrão do código (ddsd/corpus/generation/providers.py).
# Só descomente para trocar o modelo - e lembre que o nome da fonte no corpus é o do provedor.

# Groq, chave 1: provedores `groq` (gpt-oss-120b) e `groq_qwen` (qwen3.8-27b)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_QWEN_MODEL=qwen/qwen3.8-27b

# Groq, chave 2 (outra organização): provedores `groq2` (qwen3.8-27b) e `groq2_gptoss` (gpt-oss-120b)
GROQ_API_KEY_2=
# GROQ_MODEL_2=qwen/qwen3.8-27b
# GROQ2_GPTOSS_MODEL=openai/gpt-oss-120b

# Google AI Studio: provedor `gemini`
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/kimi-k3

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# LM Studio local (este Mac), endpoint nativo (permite desligar o raciocínio): provedor `lmstudio`
LMSTUDIO_URL=http://127.0.0.1:1234/api/v1/chat
# LMSTUDIO_MODEL=google/gemma-4-e4b

# Servidores LM Studio da rede (endpoint nativo /api/v1/chat): provedores `qwen` e `glm`
QWEN_BASE_URL=http://<ip-do-servidor>:1234/api/v1/chat
# QWEN_MODEL=qwen/qwen3.6-35b-a3b
GLM_BASE_URL=http://<ip-do-servidor>:1234/api/v1/chat
# GLM_MODEL=zai-org/glm-4.6v-flash
