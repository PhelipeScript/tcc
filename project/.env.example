# Copie este arquivo para .env e preencha com suas credenciais.
# Nunca commite o .env real (segredos vazam).
# Modelos/URLs abaixo refletem os defaults usados pelos scripts em src/dataset/.

# --- Chaves de API (obrigatórias para os respectivos geradores) ---
MISTRAL_API_KEY=coloque_a_sua_chave_aqui
GROQ_API_KEY=coloque_a_sua_chave_aqui
NVIDIA_API_KEY=coloque_a_sua_chave_aqui
OPENROUTER_API_KEY=coloque_a_sua_chave_aqui

# --- APIs com modelo configurável ---
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=openrouter/free

# --- LLMs locais (servidores nativos /api/v1/chat) ---
LMSTUDIO_MODEL=google/gemma-4-e4b

QWEN_BASE_URL=http://100.82.82.77:1234/api/v1/chat
QWEN_MODEL=qwen/qwen3.6-35b-a3b

DEEPSEEK_BASE_URL=http://100.100.95.56:1234/api/v1/chat
DEEPSEEK_MODEL=deepseek/deepseek-r1-0528-qwen3-8b

GLM_BASE_URL=http://100.100.95.56:1234/api/v1/chat
GLM_MODEL=zai-org/glm-4.6v-flash
